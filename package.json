{
    "name": "git-watch-vscode-rename-new",
    "publisher": "ctf0",
    "repository": {
        "type": "git",
        "url": "https://github.com/ctf0/git-watch-vscode-rename"
    },
    "displayName": "Git Watch Vscode Rename (New)",
    "description": "Automatically run 'git mv' command, when renaming files/folders in VS Code, just for occasions where only file/folder name case was changed.",
    "version": "0.0.2",
    "engines": {
        "vscode": "^1.100.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/main",
    "contributes": {},
    "scripts": {
        "vscode:prepublish": "npm run esbuild-base -- --pure:console.log --minify",
        "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/main.js --external:vscode --format=cjs --platform=node",
        "esbuild": "npm run esbuild-base -- --sourcemap",
        "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
        "watch": "npm run esbuild"
    },
    "devDependencies": {
        "@types/node": "^24.3.0",
        "@types/vscode": "^1.100.0",
        "esbuild": "^0.17.16",
        "typescript": "~5.9.2"
    },
    "dependencies": {
        "execa": "^9.6.0"
    }
}
